#!/bin/sh
# commit-msg — enforces the project's commit discipline.
#
# Installed by: git config core.hooksPath .githooks
# Bypass (do not, without a reason you can defend): git commit --no-verify
#
# Checks, in order:
#   1. no attribution trailers — one commit, one owner
#   2. no banned vague messages
#   3. no marketing phrasing
#   4. subject is lowercase, imperative-ish, and short

msg_file="$1"
# Strip comment lines before inspecting.
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)
body=$(grep -v '^#' "$msg_file")

fail() {
  echo "" >&2
  echo "  commit rejected: $1" >&2
  echo "  subject was: $subject" >&2
  shift
  for line in "$@"; do echo "  $line" >&2; done
  echo "" >&2
  exit 1
}

# ── 1. attribution: one commit, one owner ────────────────────────────────────
# Every commit belongs to the member who owns that task in the plan's task table
# (GIT_RULES §9), so *any* co-author trailer is wrong here — paired work is two
# commits, or one commit on whoever's branch it is. Matching on ownership rather than
# on a list of tool names means there is no list to keep up to date.
if printf '%s' "$body" | grep -qiE '^[[:space:]]*co-authored-by:'; then
  fail "co-author trailer" "Commits are authored by the team member who owns the task."
fi
if printf '%s' "$body" | grep -qiE 'generated with|written by|on behalf of'; then
  fail "attribution line in the body" \
       "Authorship lives in the author field, not the message. Use scripts/gitas.sh."
fi

# ── 2. banned vague messages ─────────────────────────────────────────────────
if printf '%s' "$subject" | grep -qiE '^(update|updated code|changes|change|final|final2|asdf|work done|minor fix|commit|pushed files|week[0-9]+ work|[a-z]+ changes)[[:space:]]*$'; then
  fail "banned vague message (GIT_RULES §7)" \
       "Say what changed: 'add corridor audit t-test', not 'update'."
fi

# ── 3. no bracketed prefix ───────────────────────────────────────────────────
# `[W2][DOCS] ...` was used briefly in Week 1 and is banned (GIT_RULES §7). It repeats
# what the branch name already says, the week is in the log date, and it reads as
# generated rather than written. The lowercase check below cannot catch it because the
# subject starts with '[' rather than a capital.
if printf '%s' "$subject" | grep -qE '^[[:space:]]*\['; then
  fail "bracketed prefix (GIT_RULES §7)"        "Drop it: 'add corridor audit', not '[W2][ML] add corridor audit'."
fi

# ── 4. marketing phrasing ────────────────────────────────────────────────────
if printf '%s' "$subject" | grep -qiE '\b(comprehensive|robust|extensive|seamless|leverage|utilise|utilize|holistic|cutting-edge|state-of-the-art)\b'; then
  fail "marketing wording" \
       "Write like a developer: 'add evaluation script', not 'add comprehensive evaluation'."
fi

# ── 5. shape: lowercase, short, single change ────────────────────────────────
case "$subject" in
  [A-Z]*) fail "subject must start lowercase" "e.g. 'add dataset loader'";;
esac

len=$(printf '%s' "$subject" | wc -c)
if [ "$len" -gt 72 ]; then
  fail "subject is $len chars (aim ~50, hard limit 72)" "Split it into two commits."
fi

if printf '%s' "$subject" | grep -qE '\.$'; then
  fail "subject ends with a period" "Drop it."
fi

exit 0
