# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Owner of each block is noted so you know who to ask when a key is missing.

# ── LLM providers (Krishna) ──────────────────────────────────────────────
# Primary: Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback 1: Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Fallback 2: local open model via Ollama (no key needed, just the host)
OLLAMA_HOST=http://localhost:11434
# Which provider agents use by default: gemini | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# ── Notifications for the Exception Agent (Krishna, Week 5) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Mock TMS (Mounika) ───────────────────────────────────────────────────
TMS_BASE_URL=http://localhost:8000
TMS_DB_PATH=data/tms.sqlite
TMS_API_KEY=local-dev-key

# ── Kafka / streaming (Mounika, Week 5) ──────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRIPS=delhivery.trips
KAFKA_TOPIC_ALERTS=delhivery.alerts
# Set to "file" to use the Structured Streaming file-source fallback (GIT_RULES 3-day rule)
STREAM_SOURCE=kafka

# ── Vector DB (Mounika, Week 6) ──────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Spark (all) ──────────────────────────────────────────────────────────
# Point at a JDK 17 install. Required — PySpark will not start without it.
JAVA_HOME=
SPARK_DRIVER_MEMORY=4g
SPARK_LOCAL_DIR=data/spark-tmp
