# Copy to .env.git and fill in. NEVER commit .env.git — it holds live tokens.
#
# Per-member GitHub identities and Personal Access Tokens, so each branch is
# committed AND pushed under its real owner (project rules: "Never commit or push
# everything from one account").
#
# Create a PAT: github.com → Settings → Developer settings →
#   Personal access tokens → Fine-grained tokens → Generate new token
#   Repository access: only Agentic-AI-Logistics-Control-Tower
#   Permissions: Contents = Read and write
# Each member generates their OWN and pastes it into their OWN .env.git.
# Nobody shares a token. Nobody pastes one into chat, a doc, or a commit.
#
# Krishna owns the repo, so Lahari and Mounika must be added as collaborators
# (Settings → Collaborators) before their tokens can push.

GIT_KRISHNA_NAME=krishna-2-005
GIT_KRISHNA_EMAIL=kuchurusaikrishnareddy@gmail.com
GIT_KRISHNA_TOKEN=

GIT_LAHARI_NAME=Lahari-66
GIT_LAHARI_EMAIL=laharisuresh6666@gmail.com
GIT_LAHARI_TOKEN=

GIT_MOUNIKA_NAME=Mounika-Reddy-0802
GIT_MOUNIKA_EMAIL=sherymounikareddy.2006@gmail.com
GIT_MOUNIKA_TOKEN=

